{
  "name": "devault",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "nightwatch tests/e2e/*",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "docker": "docker-compose up --build",
    "update-types": "npx supabase gen types --lang=typescript --project-id \"mxlwscwzmnfpjkeezoje\" > ./src/supabase/database.d.ts"
  },
  "dependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
