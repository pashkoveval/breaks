    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vitest/eslint-plugin": "1.1.25",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.3.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "chromedriver": "^133.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "geckodriver": "^5.0.0",
    "jiti": "^2.4.2",
    "jsdom": "^26.0.0",
    "nightwatch": "^3.11.0",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.4.2",
    "sass": "^1.85.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
