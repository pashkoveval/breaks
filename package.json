    "@typescript-eslint/utils": "^8.23.0",
    "@vueuse/core": "^12.7.0",
    "camelcase-keys": "^9.1.3",
    "class-transformer": "^0.5.1",
    "dayjs": "^1.11.13",
    "lodash": "^4.17.21",
    "pinia": "^2.3.1",
    "reflect-metadata": "^0.2.2",
    "supabase": "2.15.8",
    "vite-plugin-ts": "^1.3.2-1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@nightwatch/vue": "^3.1.2",
